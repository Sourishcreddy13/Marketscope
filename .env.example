APP_NAME=MarketScope
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/marketscope.db
# Required (>= 32 chars). Left blank on purpose: `scripts/ensure_env.sh` (run by start.sh/dev.sh/make env) generates one.
# Placeholder or short values are rejected at startup.
JWT_SECRET=
JWT_EXPIRY_MINUTES=120
MARKET_TICK_INTERVAL_SECONDS=15
AUTH_RATE_LIMIT_ATTEMPTS=5
INITIAL_CASH=100000.0000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
