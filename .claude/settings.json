{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(lint-imports:*)",
      "Bash(python:*)",
      "Bash(npm:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)",
      "Bash(curl localhost:*)",
      "Bash(curl 127.0.0.1:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(rm -rf:*)",
      "Bash(rm migrations/versions/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-length-pre.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/migration-immutability-check.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/detect-secrets.js",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/branch-protection.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/migration-immutability-check.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-gate.js",
            "timeout": 90000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/sprint-contract-gate.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/role-boundary-check.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/math-precision-check.sh",
            "timeout": 15000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scope-directory.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/protect-env.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/detect-secrets.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/lint-on-save.js",
            "timeout": 150000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck.js",
            "timeout": 200000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-architecture.js",
            "timeout": 60000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-function-length.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-file-length.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/track-writes.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/task-completed.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/teammate-idle-check.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/require-review.js",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
